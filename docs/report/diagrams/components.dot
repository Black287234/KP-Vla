digraph G {
  graph [rankdir=TB, fontname="Liberation Serif", bgcolor=white, nodesep=0.5, ranksep=0.4];
  node [shape=box, style="rounded,filled", fillcolor=white, color="#2b2d31", penwidth=1.4, fontname="Liberation Serif", fontsize=14, width=4.4, height=0.7];
  edge [color="#c27c0e", penwidth=1.5, fontname="Liberation Serif", fontsize=12];
  ui [label="Браузер: одностраничный интерфейс\n(HTML, CSS, JavaScript)", fillcolor="#fbf1df", color="#c27c0e"];
  api [label="API: конечные точки /api/…\nпроверка введённых данных"];
  sv [label="Сервисы: справочники, поступление,\nвыдача, остатки, отчёты"];
  rp [label="Хранилища (репозитории)"];
  db [label="База данных SQLite", shape=cylinder, fillcolor="#fbf1df", color="#c27c0e", width=3];
  ui -> api [label="  запросы JSON"]; api -> sv -> rp -> db;
}
