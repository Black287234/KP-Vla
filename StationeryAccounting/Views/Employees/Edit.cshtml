@model Employee
@{
    ViewData["Title"] = "Изменение сотрудника";
}

<h2 class="mb-3">Изменение данных сотрудника</h2>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="col-lg-6">
    <partial name="_EmployeeForm" model="Model" />
    <button type="submit" class="btn btn-primary">Сохранить</button>
    <a class="btn btn-secondary" asp-action="Index">Отмена</a>
</form>
