@model Product
@{
    ViewData["Title"] = Model.Name;
}

<h2 class="mb-3">Карточка товара</h2>

<dl class="row">
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Article)</dt>
    <dd class="col-sm-9">@Model.Article</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Name)</dt>
    <dd class="col-sm-9">@Model.Name</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Unit)</dt>
    <dd class="col-sm-9">@Model.Unit</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.MinQuantity)</dt>
    <dd class="col-sm-9">@Model.MinQuantity</dd>

    <dt class="col-sm-3">Состояние</dt>
    <dd class="col-sm-9">@(Model.IsArchived ? "В архиве" : "Активен")</dd>
</dl>

<div class="d-flex flex-wrap gap-2">
    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Изменить</a>
    @if (Model.IsArchived)
    {
        <form asp-action="Restore" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn btn-outline-success">Вернуть из архива</button>
        </form>
    }
    else
    {
        <form asp-action="Archive" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn btn-outline-secondary">В архив</button>
        </form>
    }
    <a class="btn btn-secondary" asp-action="Index">К списку</a>
</div>
