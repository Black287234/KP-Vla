@model Product
@{
    ViewData["Title"] = "Изменение товара";
}

<h2 class="mb-3">Изменение товара</h2>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="col-lg-6">
    <partial name="_ProductForm" model="Model" />
    <button type="submit" class="btn btn-primary">Сохранить</button>
    <a class="btn btn-secondary" asp-action="Details" asp-route-id="@Model.Id">Отмена</a>
</form>
