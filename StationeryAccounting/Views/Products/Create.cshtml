@model Product
@{
    ViewData["Title"] = "Новый товар";
}

<h2 class="mb-3">Новый товар</h2>

<form asp-action="Create" method="post" class="col-lg-6">
    <partial name="_ProductForm" model="Model" />
    <button type="submit" class="btn btn-primary">Сохранить</button>
    <a class="btn btn-secondary" asp-action="Index">Отмена</a>
</form>
