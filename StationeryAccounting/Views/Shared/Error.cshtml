@model ErrorViewModel
@{
    ViewData["Title"] = "Ошибка";
}

<div class="alert alert-danger">
    <h4 class="alert-heading">Произошла ошибка</h4>
    <p class="mb-0">При обработке запроса что-то пошло не так. Попробуйте повторить действие.</p>
</div>

@if (Model?.ShowRequestId == true)
{
    <p class="text-muted">Код запроса: <code>@Model.RequestId</code></p>
}
