<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Учёт канцтоваров</title>
    <!-- Bootstrap подключён с CDN, поэтому для оформления нужен интернет -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-md navbar-dark bg-primary mb-4">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">Учёт канцтоваров</a>
                <ul class="navbar-nav flex-row flex-wrap gap-2">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Products" asp-action="Index">Товары</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Products" asp-action="BelowMin">Ниже минимума</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Operations" asp-action="Receipt">Поступление</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Operations" asp-action="Issue">Выдача</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Operations" asp-action="Index">История</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Operations" asp-action="Totals">Итоги</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Employees" asp-action="Index">Сотрудники</a>
                    </li>
                </ul>
            </div>
        </nav>
    </header>

    <main class="container pb-4">
        @* Сообщения об успехе и ошибке после перенаправления (TempData живёт один запрос) *@
        @if (TempData["Message"] is string message)
        {
            <div class="alert alert-success">@message</div>
        }
        @if (TempData["Warning"] is string warning)
        {
            <div class="alert alert-warning">@warning</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger">@error</div>
        }

        @RenderBody()
    </main>

    <footer class="border-top text-muted py-3">
        <div class="container">
            © 2026 — Модуль учёта движения канцелярских товаров
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
